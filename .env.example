PORT=3000
EVM_PRIVATE_KEY=
WALLET_MODE=simulation
TELEGRAPH_NODE=https://devnode.telegraphprotocol.com
TELEGRAPH_INTENT=LLM_OUTPUT_EVALUATION_GENERAL
TELEGRAPH_RAIL=escrow
TELEGRAPH_MINER_ID=76441
TELEGRAPH_RECEIVER=0x72a70e949362670Bf8bceAd24eFC5b8f950aa08b
MAX_REVIEW_UUSDC=30000
DAILY_REVIEW_UUSDC=1000000
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional OpenAI-compatible planner endpoint.
AGENT_MODEL_URL=
AGENT_MODEL_KEY=
AGENT_MODEL_NAME=
# Paid review routing. "dual" buys a first review and, when the answer is
# uncertain or the text is high stakes, a second opinion from a different
# Intent. "single" uses TELEGRAPH_INTENT only.
AIMO_REVIEW_MODE=dual
# These match the providers used in the published v2 benchmark.
AIMO_PRIMARY_INTENT=SECURITY_REVIEW_GENERAL
AIMO_PRIMARY_MINER_ID=731970
AIMO_SECOND_INTENT=CONTENT_MODERATION_GENERAL
AIMO_SECOND_MINER_ID=7423
# Paid TRANSACTION_RISK_GENERAL check before memory-influenced or large
# transfers. It can only block; it never approves.
AIMO_ACTION_REVIEW=on
AIMO_ACTION_REVIEW_MIN_UUSDC=1000000
